# Firebase Admin configuration (server)
# RECOMMENDED METHOD for hosting environments like Hostinger, Render, etc.
# Get these values from your Firebase service account JSON file.
# Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client-email@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...your-private-key...
-----END PRIVATE KEY-----
"

# DEPRECATED METHOD: Less secure and prone to errors with multi-line strings.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id",...}'
# FIREBASE_SERVICE_ACCOUNT_PATH='/path/to/firebase-admin-key.json'

